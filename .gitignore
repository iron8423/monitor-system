# Java / Maven
target/
backend/target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/*
# 例外：把 Java 诊断口径（null 分析模式）共享出去——它决定"问题"面板里有没有噪音，
# 每个人都自己配一遍必然会漂。理由见 docs/IDE_Java告警口径_20260920.md
!.vscode/settings.json
.classpath
.project
.settings/

# Node / Vue / frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.pnpm-store/
frontend/.vite/

# Python（tools/radar_csv_replay 等）
__pycache__/
*.pyc
.venv/
venv/

# 运行时上传的影像（monitor.upload.dir 默认 ./data/media，相对 backend 工作目录）
data/
backend/data/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
*.env
.env.*
# 但模板要入库：它是「有哪些变量、默认值是什么」的唯一说明
!.env.example
!.env.production.example
# 开发环境默认值入库（2026-09-22）：让"拉下来 → npm run dev"就能看到三维预览，
# 不需要每个人再手抄一份 .env.local。个人差异（ion token 等）仍放 .env.local 覆盖。
!.env.development
# 三个可复现档位（2026-09-23）：现状档= .env.development；参考档= .env.hires；清远档= .env.qingyuan
# 它们只含"用哪套资产/哪层远景/什么材质档"，不含任何密钥；个人差异仍放 *.local（下一行忽略）。
!.env.hires
!.env.qingyuan
*.local
application-local.yml

# 备份产物（tools/backup/*.sh 的输出；含全库 dump，不入库）
backups/

# 三维预览资产（2026-09-22 清理）：
#   这些 GLB 的纹理来自 Google/高德影像，**服务条款禁止离线缓存与二次分发**，
#   推上共享仓库等于再分发；而且单个文件 30 MB 级，几个版本就上百 MB。
#   正式资产要走"新版本号迁移 + 更新 asset_sha256"，不走这里。
# 说明（2026-09-22 更新）：上面三个目录**曾经被排除**，理由是"Google 影像不得再分发"。
# 2026-09-22 仓库已改为 **private**，资产改为随仓库一起管理（内部预览用），
# 所以这里不再忽略——但**公开仓库绝不能提交它们**，换仓库可见性前请先看
# docs/预览环境搭建_给A_20260922.md 的许可见解。

# 子目录里的 IDE 配置（根 .vscode/* 规则管不到 backend/.vscode）
backend/.vscode/
