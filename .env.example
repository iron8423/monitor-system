# 复制成 .env 后按需修改（.env 不入库，见 .gitignore）。
# 不复制也能跑：docker-compose.yml 里每个变量都有演示默认值。
#
#   cp .env.example .env

# --- PostgreSQL ---
PG_DB=monitor
PG_USER=monitor
PG_PASSWORD=monitor
# 宿主机映射端口（容器之间始终走 db:5432，这个只影响你从宿主机连进去）
PG_PORT=5432

# --- 后端 ---
# 宿主机映射端口
BACKEND_PORT=8080
# 生产/联调必须换成自己的值：HS256 要求 >= 32 字节，换掉会让已签发的 token 全部失效
JWT_SECRET=monitor-system-demo-secret-key-please-change-in-prod-0123456789
# ingest 接入密钥，上报端（模拟器/回放器）的 X-Ingest-Key 要和这里一致
MONITOR_INGEST_KEY=dev-ingest-key

# --- 前端 ---
# 宿主机映射端口（80 需要 root 之外的权限吗？不需要——由 docker 转发，你以普通
# 用户就能跑；只是若本机已有服务占了 80，改这里）
FRONTEND_PORT=80

# Cesium ion 访问令牌：https://ion.cesium.com/tokens
# 注意两点：
#   ① 它是**构建期**变量（Vite 内联进产物），改完要 `docker compose build frontend`
#      重建镜像，只 `restart` 不生效；
#   ② token 会随构建产物公开，请在 ion 后台限制来源域名与额度。
# 留空 = 3D 大屏走「无地形兜底底图」的降级路径，不白屏、功能正常，只是没地形。
VITE_CESIUM_ION_TOKEN=

# 地形模式：ion（官方真实地形）/ none（纯椭球，断网演示兜底）
VITE_TERRAIN_MODE=ion
