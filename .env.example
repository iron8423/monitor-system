# 复制成 .env 后按需修改（.env 不入库，见 .gitignore）。
# 不复制也能跑：docker-compose.yml 里每个变量都有演示默认值。
#
#   cp .env.example .env

# --- PostgreSQL ---
PG_DB=monitor
PG_USER=monitor
PG_PASSWORD=monitor
# 宿主机映射端口（容器之间始终走 db:5432，这个只影响你从宿主机连进去）
PG_PORT=5432

# --- 后端 ---
# 宿主机映射端口
BACKEND_PORT=8080
# 生产/联调必须换成自己的值：HS256 要求 >= 32 字节，换掉会让已签发的 token 全部失效
JWT_SECRET=monitor-system-demo-secret-key-please-change-in-prod-0123456789
# ingest 接入密钥，上报端（模拟器/回放器）的 X-Ingest-Key 要和这里一致
MONITOR_INGEST_KEY=dev-ingest-key
