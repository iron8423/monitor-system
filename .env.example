# 复制成 .env 后按需修改（.env 不入库，见 .gitignore）。
# 不复制也能跑：docker-compose.yml 里每个变量都有演示默认值。
#
#   cp .env.example .env

# --- PostgreSQL ---
PG_DB=monitor
PG_USER=monitor
PG_PASSWORD=monitor
# 宿主机映射端口（容器之间始终走 db:5432，这个只影响你从宿主机连进去）
PG_PORT=5432

# --- 后端 ---
# 宿主机映射端口
BACKEND_PORT=8080
# 生产/联调必须换成自己的值：HS256 要求 >= 32 字节，换掉会让已签发的 token 全部失效
JWT_SECRET=monitor-system-demo-secret-key-please-change-in-prod-0123456789
# ingest 接入密钥，上报端（模拟器/回放器）的 X-Ingest-Key 要和这里一致
MONITOR_INGEST_KEY=dev-ingest-key
# 生产必须保持 true；只有联调尚未补齐 schemaVersion/sequence/绑定档案的旧设备才临时关闭。
INGEST_STRICT_CONTRACT=true
# 10 台雷达 / 1000 点可整轮上报；不要无限放大，以免单请求耗尽内存或数据库参数。
INGEST_MAX_BATCH_SIZE=2000
# 时钟偏差容忍（秒）：采集时间超前平台时间超过它即拒收（COLLECT_TIME_IN_FUTURE），
# 接收时间超前超过它则钳到当前时刻。300 秒与设备离线判据（5 分钟）同量级，
# 且远大于任何合理的网关缓冲。**这是物理常量不是安全姿态**，dev 与生产用同一个值。
INGEST_MAX_COLLECT_AHEAD_SECONDS=300
INGEST_MAX_RECEIVE_AHEAD_SECONDS=300

# --- 前端 ---
# 宿主机映射端口（80 需要 root 之外的权限吗？不需要——由 docker 转发，你以普通
# 用户就能跑；只是若本机已有服务占了 80，改这里）
FRONTEND_PORT=80

# 场景模式：mountain（默认，完全离线本地山体）/ globe（原全球底图模式）
VITE_SCENE_MODE=mountain

# 以下两项仅在 VITE_SCENE_MODE=globe 时使用。
# Cesium ion 访问令牌：https://ion.cesium.com/tokens
# 注意两点：
#   ① 它是**构建期**变量（Vite 内联进产物），改完要 `docker compose build frontend`
#      重建镜像，只 `restart` 不生效；
#   ② token 会随构建产物公开，请在 ion 后台限制来源域名与额度。
# 留空 = 全球模式走「无地形兜底底图」的降级路径。
VITE_CESIUM_ION_TOKEN=

# 地形模式：ion（官方真实地形）/ none（纯椭球，断网演示兜底）
VITE_TERRAIN_MODE=ion

# GLB / 3D Tiles 的宿主机目录，运行期只读挂载到前端 /models/。
DIGITAL_TWIN_ASSET_DIR=./frontend/public/models
