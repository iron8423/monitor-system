# 复制为 .env.production，填写后用：
# docker compose --env-file .env.production -f docker-compose.production.yml up -d --build

PG_DB=monitor
PG_USER=monitor
PG_PASSWORD=请替换为随机数据库密码

# 至少 32 字节；建议 openssl rand -base64 48
JWT_SECRET=请替换为至少32字节随机字符串
# 建议 openssl rand -hex 32，并同步给雷达转换器
MONITOR_INGEST_KEY=请替换为随机接入密钥

INGEST_MAX_BATCH_SIZE=2000
JAVA_OPTS=-Xms512m -Xmx2048m -XX:+ExitOnOutOfMemoryError

# 演示账号初始化：生产保持 false。
# 打开会创建 admin/operator/analyst/maintainer/outsider 五个账号（口令见 DEMO_ACCOUNT_PASSWORD），
# 那是一组谁都知道口令的入口；确需现场演示时临时改为 true。
MONITOR_DEMO_ACCOUNTS=false
# 仅在 MONITOR_DEMO_ACCOUNTS=true 时有意义。不设则用 123456。
# DEMO_ACCOUNT_PASSWORD=请替换为随机口令

BIND_ADDRESS=0.0.0.0
FRONTEND_PORT=80
DIGITAL_TWIN_ASSET_DIR=./frontend/public/models
