{
  "schemaVersion": "M0-align-1.0",
  "purpose": "B 与 A 的 M0 契约对齐。baseline = B 侧契约基准（已填）；actual = A 侧实际实现（待 A 用 AI 填）。A 填完整份返回后，对比 baseline vs actual 即可找出差异。",
  "howToUse": "把本文件发给 A（或其 AI）：A 打开后逐项看 baseline + note，对照自己的 schema/OpenAPI/代码，把 actual 填成 A 的真实实现值，然后原样返回。对比时：actual 缺失或与 baseline 不一致 = 待对齐项。",
  "items": [
    {
      "id": "msg.metrics",
      "group": "消息契约-测项",
      "note": "点形变雷达主指标；若 A 用 dispX/Y/Z、horizontal 则为冲突",
      "baseline": { "defo_mm": "mm", "rate_mm_d": "mm/d" },
      "actual": null
    },
    {
      "id": "msg.fieldset",
      "group": "消息契约-字段",
      "note": "单条消息应含这些字段；A 的 DTO 字段名/层级需一致",
      "baseline": ["schemaVersion", "messageId", "deviceId", "pointCode", "collectTime", "receiveTime", "sequence", "metrics", "quality", "position{angleDeg,distanceM}", "signal", "state", "monitored"],
      "actual": null
    },
    {
      "id": "msg.idempotency",
      "group": "消息契约-幂等",
      "note": "[冻结A口径] 整条消息去重；重复不重复写、不重复告警",
      "baseline": ["device_id", "message_id"],
      "actual": null
    },
    {
      "id": "msg.quality",
      "group": "消息契约-质量标记",
      "note": "异常数据默认不参与告警判定，不覆盖原值",
      "baseline": ["RAW", "VALID", "SUSPECT", "FAULT"],
      "actual": null
    },
    {
      "id": "msg.time_units",
      "group": "消息契约-时间/单位",
      "note": "采集/接收时间分开；位移 mm、速率 mm/d",
      "baseline": { "timeFormat": "ISO8601+08:00", "units": "mm / mm/d", "splitClock": ["collectTime", "receiveTime"] },
      "actual": null
    },
    {
      "id": "enum.alarmLevel",
      "group": "枚举-告警级别",
      "baseline": ["notice", "warning", "alarm"],
      "actual": null
    },
    {
      "id": "enum.alarmStatus",
      "group": "枚举-警情状态",
      "baseline": ["PENDING", "CONFIRMED", "PROCESSING", "OBSERVING", "RESOLVED", "FALSE_ALARM"],
      "actual": null
    },
    {
      "id": "enum.action",
      "group": "枚举-处置动作",
      "baseline": ["confirm", "research", "dispatch", "handle", "resolve", "misreport"],
      "actual": null
    },
    {
      "id": "enum.deviceHealth",
      "group": "枚举-设备健康",
      "baseline": ["NORMAL", "LOW_BATTERY", "OFFLINE", "DATA_ABNORMAL"],
      "actual": null
    },
    {
      "id": "enum.ruleType",
      "group": "枚举-规则类型",
      "baseline": ["THRESHOLD", "RATE", "CHANGE"],
      "actual": null
    },
    {
      "id": "api.ingest",
      "group": "接口-接入",
      "note": "单条或 {items:[...]}；返回 accepted/rejected/duplicates；/ingest 免 JWT(网关/共享密钥)",
      "baseline": { "method": "POST", "path": "/api/v1/ingest/measurements", "req": "single|{items}", "resp": { "accepted": "int", "rejected": "int", "duplicates": "int", "results": [{ "pointCode": "string", "collectTime": "string", "status": "OK|DUPLICATE|REJECTED", "quality": "enum" }] }, "auth": "gateway/共享密钥" },
      "actual": null
    },
    {
      "id": "api.latest",
      "group": "接口-最新值",
      "baseline": { "method": "GET", "path": "/api/v1/points/{pointId}/latest", "respKeys": ["pointId", "pointCode", "latest{collectTime,defo_mm,rate_mm_d,quality,signal,position}", "state"] },
      "actual": null
    },
    {
      "id": "api.series",
      "group": "接口-时序曲线",
      "note": "query: metricCode(from defo_mm/rate_mm_d), from, to, granularity(raw|hour|day)",
      "baseline": { "method": "GET", "path": "/api/v1/points/{pointId}/series", "query": ["metricCode", "from", "to", "granularity"], "resp": { "pointId": "string", "pointCode": "string", "metricCode": "string", "unit": "string", "points": [{ "t": "string", "v": "number" }] } },
      "actual": null
    },
    {
      "id": "api.summary",
      "group": "接口-项目概览",
      "baseline": { "method": "GET", "path": "/api/v1/projects/{projectId}/summary", "respKeys": ["projectId", "pointCount", "alertCount", "onlineDeviceCount", "maxDeformationMm"] },
      "actual": null
