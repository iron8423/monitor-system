    {
      "id": "api.alarms",
      "group": "接口-告警",
      "note": "列表筛选 level/status/pointId/from/to + 分页；详情含处置时间线",
      "baseline": { "list": { "method": "GET", "path": "/api/v1/alarms", "filters": ["level", "status", "pointId", "from", "to", "page", "size"] }, "detail": { "method": "GET", "path": "/api/v1/alarms/{id}", "respKeys": ["id", "pointId", "pointCode", "level", "status", "triggeredAt", "snapshot", "timeline[]"] } },
      "actual": null
    },
    {
      "id": "api.alarmAction",
      "group": "接口-处置",
      "note": "body: action/comment/operator；返回更新后 status + timeline",
      "baseline": { "method": "POST", "path": "/api/v1/alarms/{id}/actions", "body": { "action": "confirm|research|dispatch|handle|resolve|misreport", "comment": "string", "operator": "string" }, "respKeys": ["id", "status", "timeline[]"] },
      "actual": null
    },
    {
      "id": "api.alarmRules",
      "group": "接口-规则CRUD",
      "note": "[冻结A口径] 列名下划线；默认种子 defo_mm THRESHOLD gte 10 / 恢复 5",
      "baseline": { "methods": ["GET", "POST", "PUT", "DELETE"], "path": "/api/v1/alarm-rules", "columnSet": ["point_id", "metric_code", "rule_type", "operator", "threshold_value", "window_minutes", "recovery_value", "level", "repeat_suppress_seconds", "enabled"] },
      "actual": null
    },
    {
      "id": "api.deviceStatus",
      "group": "接口-设备状态",
      "note": "[冻结A口径] 设备状态接口归 A（ONLINE/OFFLINE/FAULT）；B 不再提供。B 如需 health(含 DATA_ABNORMAL) 基于 A 状态+数据质量另出",
      "baseline": { "owner": "A", "method": "GET", "path": "/api/v1/devices/{deviceId}/status", "respKeys": ["deviceId", "code", "status", "online", "battery", "lowBattery", "lastReportTime"] },
      "actual": null
    },
    {
      "id": "api.stream",
      "group": "接口-实时SSE",
      "note": "text/event-stream；事件 measurement / alarm",
      "baseline": { "method": "GET", "path": "/api/v1/stream", "contentType": "text/event-stream", "events": ["measurement", "alarm"] },
      "actual": null
    },
    {
      "id": "api.media",
      "group": "接口-媒体",
      "baseline": { "upload": { "method": "POST", "path": "/api/v1/media", "form": ["file", "pointId", "takenAt", "note"] }, "list": { "method": "GET", "path": "/api/v1/points/{pointId}/media" } },
      "actual": null
    },
    {
      "id": "conv.basePath",
      "group": "约定-路径",
      "baseline": "/api/v1",
      "actual": null
    },
    {
      "id": "conv.envelope",
      "group": "约定-响应信封",
      "note": "A 的 common.Result<T>；code=0 成功",
      "baseline": { "code": "int", "message": "string", "data": "object", "successCode": 0 },
      "actual": null
    },
    {
      "id": "conv.auth",
      "group": "约定-鉴权",
      "note": "[冻结A口径] /ingest 用 X-Ingest-Key；/stream 用 ?token=；其余 Bearer JWT",
      "baseline": { "ingest": "X-Ingest-Key: <MONITOR_INGEST_KEY> header, no JWT", "stream": "GET /api/v1/stream?token=<JWT>", "others": "Authorization: Bearer <JWT>", "authorize": "method-level roles (RBAC)" },
      "actual": null
    },
    {
      "id": "conv.pagination",
      "group": "约定-分页",
      "baseline": { "page": 1, "size": 20, "totalKey": "total" },
      "actual": null
    },
    {
      "id": "table.measurement",
      "group": "表-测量值时序",
      "baseline": { "columns": ["pointCode", "metricCode", "collectTime", "value", "quality", "rawRef", "deviceId"], "index": ["pointCode,metricCode,collectTime"], "engine": "PostgreSQL(table+index) 或预留 TDengine" },
      "actual": null
