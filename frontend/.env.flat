# 对照档（白模）：`npx vite --mode flat`
#
# 这是"轻量数据档"的样子：正射底图 + CityGML LoD2 建筑**白模**（顶点色、烘焙明暗，无贴图）。
# 用途：与默认档（灰模 + 屋面贴正射影像）做同机位对照，说明"数据精度与贴图档位"带来的差别。
# 之所以保留它：汇报时"先看现在这样、再看数据到位后那样"这一前一后，靠的就是这一档。
#
# ⚠️ Vite 的 mode 文件不叠加 .env.development，本文件自带完整变量。
# 资产来源与署名见 frontend/public/models/wh-plant/ASSET_PROVENANCE.md。

VITE_API_BASE_URL=/api
VITE_APP_TITLE=通用监测管理系统
VITE_BACKEND_ORIGIN=http://localhost:8080

# 现状档资产：苏黎世 Werdhölzli 厂区（SWISSIMAGE z19 0.2 m + swissALTI3D 0.5 m + 官方 CityGML LoD2，建筑为白模）
VITE_ASSET_OVERRIDE=/models/wh-plant/wh-plant.glb
# 演示锚点覆盖（只改内存里的 config，不动数据库档案）；必须与 public/farfield 远景瓦片同址
VITE_ANCHOR_OVERRIDE=8.506,47.3935,395
# 远景：仓库内 swisstopo SWISSIMAGE 瓦片金字塔（z6~z17，离线可用，OGD 需署名）
VITE_FARFIELD=local
VITE_FARFIELD_TERRAIN=0

# 雾与相机（与默认档保持一致，保证同机位可比）
VITE_FOG_DENSITY=0.0003
VITE_FOG_VISUAL_SCALAR=0.2
VITE_CAMERA_PITCH=-26
VITE_CAMERA_FIT_MAX_RANGE=2800
VITE_CAMERA_FIT_RADIUS_FACTOR=0.42
VITE_CAMERA_FIT_MARGIN=0.98
VITE_CAMERA_MIN_PITCH=-85
VITE_CAMERA_MAX_PITCH=14
VITE_MAX_ZOOM_FACTOR=2.5
VITE_MIN_ZOOM_FACTOR=0.05
VITE_PIN_HEIGHT_M=60
VITE_RESOLUTION_SCALE=2

# 烘焙明暗（不受场景时钟影响）
VITE_RENDER_MODE=flat
