# 开发期：走 vite.config.js 的 proxy，请求同源 /api/** → http://localhost:8080/api/**
VITE_API_BASE_URL=/api
VITE_APP_TITLE=通用监测管理系统
# 后端地址（仅用于界面上展示/排查，实际请求由 proxy 转发）
VITE_BACKEND_ORIGIN=http://localhost:8080

# ── 三维大屏预览（2026-09-22 入库；2026-09-23 起拆成三个档位）──────────────────
# 资产随仓库一起管理（仓库为 private，内部预览用；公开仓库不得提交这些影像派生资产）
# 个人差异仍然写 .env.local 覆盖，例如自己的 Cesium ion token。
#
# ⚠️ 优先级陷阱（2026-09-23 实测）：Vite 的加载顺序是
#     .env < .env.local < .env.[mode] < .env.[mode].local
#   也就是说**本文件（.env.development）会覆盖 .env.local**。
#   所以要临时改这里的任何一项，请写 `frontend/.env.development.local`（优先级最高、不进 git），
#   而不是写在 .env.local 里——否则改了看不到效果（这个坑已经踩过一次）。
#
# 三个可复现档位（都随仓库入库，clone 即可跑）：
#   · 现状档（默认，就是本文件）  `npm run dev`                     → 苏黎世 Werdhölzli 厂区（wh-plant）
#   · 参考档（航拍级）            `npx vite --mode hires --port 5174` → wh-plant-hires（0.1 m 正射 + 屋面贴真实影像）
#   · 清远档（上一版默认）        `npx vite --mode qingyuan`         → 清远电厂预览资产
#   ⚠️ Vite 的 mode 文件**不叠加** .env.development，每个档位文件必须自带完整变量（三份都已写全）。

# 现状档资产：苏黎世 Werdhölzli 厂区（SWISSIMAGE z19 0.2 m + swissALTI3D 0.5 m + 官方 CityGML LoD2 真几何）
# 跳过 SHA-256 核对；正式化要走新版本号迁移 + 更新 asset_sha256。来源与署名见同目录 ASSET_PROVENANCE.md
VITE_ASSET_OVERRIDE=/models/wh-plant/wh-plant.glb

# 演示锚点覆盖（只改内存里的 config，不动数据库档案）：必须与 public/farfield 远景瓦片同址，
# 否则四周只会命中金字塔最外层（一个像素几百米，糊成一片）。
VITE_ANCHOR_OVERRIDE=8.506,47.3935,395

# 远景层：local = 仓库内 public/farfield/ 的 swisstopo SWISSIMAGE 瓦片金字塔（z6~z17，离线可用；
# swisstopo 为开放数据 OGD，允许离线缓存与再分发，需署名）；+ion 表示再垫一层在线影像兜更远，
# 没有 ion token 时那层加载失败、不影响本地远景。现状档与远景同址（都在苏黎世），所以不需要 ion。
VITE_FARFIELD=local
VITE_FARFIELD_TERRAIN=0

# 雾：两个参数必须一起给才有效（公式见 src/cesium/createViewer.js 顶部）
# 2026-09-23：远景层的最外几层（z6~z11）是"一个像素几百米"的低清影像，
# 再往外就是地块贴图（模型自带正射）与远景瓦片的接缝。雾在这里是**唯一便宜的解法**：
# 把 3 km 之外压成一层雾，接缝与低清底图都退到背景里，近处（1 km 内）几乎不受影响。
# 0.08 → 0.2：3 km 处约 33% 雾化（原来约 14%），5 km 处约 47%。
VITE_FOG_DENSITY=0.0003
VITE_FOG_VISUAL_SCALAR=0.2

# 相机与画布
# 默认俯角（2026-09-23 用户反馈"视角太高、像看地图"）：从 -38° 降到 -26°，
# 能看到建筑立面与天际线；分区内的相机预设更低（-14°，见 public/zones.json）
VITE_CAMERA_PITCH=-26
VITE_CAMERA_FIT_MAX_RANGE=2800
VITE_CAMERA_FIT_RADIUS_FACTOR=0.42
VITE_CAMERA_FIT_MARGIN=0.98
# 俯仰可达范围（2026-09-23 用户反馈"旋转受限"）：
#   以前是 [-85°, -8°]，也就是从默认 -26° 只能往上转 18° 就顶住了，
#   想看天际线/立面时特别"顶手"。现在放宽到几乎平视（+14° 能看到一点天空与雾）。
VITE_CAMERA_MIN_PITCH=-85
VITE_CAMERA_MAX_PITCH=14
# 缩放倍率：以"取景距离"为 1.0。> 1 是能拉多远，< 1 是能推多近。
#   以前最大距离被钉死在 1.0（=取景距离本身），等于**不能往外缩**；
#   能推近的下限也只有 0.12（约 125 m），推不到建筑旁边。
VITE_MAX_ZOOM_FACTOR=2.5
VITE_MIN_ZOOM_FACTOR=0.05
VITE_PIN_HEIGHT_M=60
VITE_RESOLUTION_SCALE=2
VITE_RENDER_MODE=flat
