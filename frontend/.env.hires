# 航拍级参考档（2026-09-23）：`npx vite --mode hires --port 5174`
#
# 这一档回答的是"当我们同时有航拍正射 + 高精度地形时，方案能做成什么样"：
# 与现状档（.env.development）的**唯一差别是数据精度与材质档位**，场地、锚点、分区、测点全部不变，
# 所以两张截图是同机位可比的。用途：给公司/甲方汇报"免费公开数据的上限"。
#
# ⚠️ Vite 的 mode 文件不叠加 .env.development，本文件必须自带完整变量（下面已写全）。
# 个人差异仍写 .env.hires.local（不进 git，优先级最高）。
# 资产来源与署名见 frontend/public/models/wh-plant-hires/ASSET_PROVENANCE.md。

VITE_API_BASE_URL=/api
VITE_APP_TITLE=通用监测管理系统
VITE_BACKEND_ORIGIN=http://localhost:8080

# ── 资产与场景 ────────────────────────────────────────────────
# 0.1 m 航拍正射（SWISSIMAGE z20）+ 0.5 m 实测高程（swissALTI3D）+ 官方 CityGML LoD2 真几何（屋面贴正射影像）
VITE_ASSET_OVERRIDE=/models/wh-plant-hires/wh-plant-hires.glb
VITE_ANCHOR_OVERRIDE=8.506,47.3935,395
# 远景：仓库内 swisstopo SWISSIMAGE 瓦片金字塔（与资产同址，离线可用）
VITE_FARFIELD=local
VITE_FARFIELD_TERRAIN=0

# ── 雾与相机（与现状档一致，保证同机位可比） ──────────────────────
VITE_FOG_DENSITY=0.0003
VITE_FOG_VISUAL_SCALAR=0.2
VITE_CAMERA_PITCH=-26
VITE_CAMERA_FIT_MAX_RANGE=2800
VITE_CAMERA_FIT_RADIUS_FACTOR=0.42
VITE_CAMERA_FIT_MARGIN=0.98
VITE_CAMERA_MIN_PITCH=-85
VITE_CAMERA_MAX_PITCH=14
VITE_MAX_ZOOM_FACTOR=2.5
VITE_MIN_ZOOM_FACTOR=0.05
VITE_PIN_HEIGHT_M=60
VITE_RESOLUTION_SCALE=2

# ── 材质档位（这一档与现状档的真正差别） ──────────────────────────
# 受光渲染：PBR 材质 + 实时日照（资产也必须用 lit 材质，否则看到的是烘焙明暗）
VITE_RENDER_MODE=lit
VITE_HDR=1
# AO 关：实测在 0.1 m 正射 + 2 m 网格下，环境光遮蔽会在立面上自遮蔽出一层规则斜纹，关掉即干净
VITE_AO=0
# 实时阴影关：正射影像里本来就有真实日照与建筑投影，再叠实时阴影属于重复计算，
# 且阴影贴图自遮蔽会在地面糊出细网格（详见 frontend/src/cesium/renderProfile.js 的说明）
VITE_SHADOWS=0
