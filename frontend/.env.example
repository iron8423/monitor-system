# 配置模板（可提交）。真实值放 .env.local（不提交）。
# 开发期请求走 vite.config.js 的代理，所以这里只写前缀
VITE_API_BASE_URL=/api
VITE_APP_TITLE=通用监测管理系统
VITE_BACKEND_ORIGIN=http://localhost:8080

# Cesium ion 访问令牌：https://ion.cesium.com/tokens
# 注意：前端里的 token 会随构建产物公开，请在 ion 后台限制来源域名与额度
VITE_CESIUM_ION_TOKEN=

# 地形模式：ion（官方真实地形）/ none（纯椭球，断网演示兜底）
VITE_TERRAIN_MODE=ion
