# 配置模板（可提交）。真实值放 .env.local（不提交）。
# 开发期请求走 vite.config.js 的代理，所以这里只写前缀
VITE_API_BASE_URL=/api
VITE_APP_TITLE=通用监测管理系统
VITE_BACKEND_ORIGIN=http://localhost:8080

# 场景模式：mountain（默认，完全离线本地山体）/ globe（原全球底图模式）
VITE_SCENE_MODE=mountain

# 以下两项仅在 VITE_SCENE_MODE=globe 时使用。
# Cesium ion 访问令牌：https://ion.cesium.com/tokens
# 注意：前端里的 token 会随构建产物公开，请在 ion 后台限制来源域名与额度
VITE_CESIUM_ION_TOKEN=

# 地形模式：ion（官方真实地形）/ none（纯椭球，断网演示兜底）
VITE_TERRAIN_MODE=ion

# ── 三维大屏：远景层（2026-09-22）──────────────────────────────
# 地块之外的影像，解决"转到哪都看到地块边缘"。
#   local+ion（推荐）= 本地 Google 瓦片金字塔（public/farfield/，不联网）+ ion 影像兜更远
#   local / ion / off（off = 只有地块，深色底，断网兜底）
VITE_FARFIELD=ion
# 远景是否需要真实起伏（Cesium 全球地形）。默认关：本地方块与全球地形高程差几十米，
# 打开后真地形会从地块里"冒出来"。
VITE_FARFIELD_TERRAIN=0
# 远景色调（只在远景**不是**本地 Google 源时生效：Bing 在本场址饱和度高一倍且偏黄）
VITE_FARFIELD_SATURATION=1
VITE_FARFIELD_BRIGHTNESS=1

# ── 三维大屏：雾（航空透视）──────────────────────────────────
# ⚠️ 两个都要给才有效：fog = 1 - exp(-((k·s+k)·s·(1+k)))，s = 距离 × density
# 只调 density、不给 visualDensityScalar，在 3~10km 尺度上几乎看不到效果。
# 参考值：density=0.0003 + scalar=0.08 → 3km 约 15%、10km 约 70%
VITE_FOG_DENSITY=0.0002
VITE_FOG_VISUAL_SCALAR=0.08

# ── 三维大屏：相机 ──────────────────────────────────────────
VITE_CAMERA_PITCH=-38            # 默认俯角
VITE_CAMERA_FIT_MAX_RANGE=2800   # 取景距离上限（0/缺省=按包围球算，会退到 5km 外）
VITE_CAMERA_FIT_RADIUS_FACTOR=0.42  # 填满程度：越小越满（0.38 更满，0.48 更松）
VITE_CAMERA_FIT_MARGIN=0.98
VITE_CAMERA_MIN_PITCH=-85        # 允许的俯仰范围：接近水平到接近垂直
VITE_CAMERA_MAX_PITCH=-8
VITE_MAX_ZOOM_FACTOR=2.5         # 缩放上限 = 取景距离 × 该系数
VITE_PIN_HEIGHT_M=60             # 测点空中标签的引线高度（米）
VITE_RESOLUTION_SCALE=2          # 画布分辨率倍率（1.2 省性能 / 2 最锐）

# 临时把场景资产指向本地预览 GLB（跳过 SHA-256 核对；正式化要走新版本号迁移）
# VITE_ASSET_OVERRIDE=/models/<资产目录>/<资产>.glb
