# 清远档（2026-09-23 从原 .env.development 原样搬过来）：`npx vite --mode qingyuan`
#
# 这是 2026-09-22 那一版的默认档：清远电厂预览资产 + 在线影像兜底。
# 保留它的原因：清远才是真正要落地的场址，这一档是"换场址后长什么样"的对照。
# 注意：仓库内 public/farfield 的瓦片金字塔是**苏黎世**的，与清远不同址，
# 所以这一档用 local+ion，实际主要靠在线影像兜底。
#
# ⚠️ Vite 的 mode 文件不叠加 .env.development，本文件必须自带完整变量（下面已写全）。

# 开发期：走 vite.config.js 的 proxy，请求同源 /api/** → http://localhost:8080/api/**
VITE_API_BASE_URL=/api
VITE_APP_TITLE=通用监测管理系统
VITE_BACKEND_ORIGIN=http://localhost:8080

# 清远电厂预览资产（跳过 SHA-256 核对；正式化要走新版本号迁移 + 更新 asset_sha256）
VITE_ASSET_OVERRIDE=/models/qingyuan-powerplant-big/qingyuan-powerplant-big.glb

# 远景层：local = 仓库内 public/farfield/ 瓦片（离线可用，但那是苏黎世的）；
# +ion 表示再垫一层在线影像兜更远，没有 ion token 时那层加载失败、不影响本地远景。
VITE_FARFIELD=local+ion
VITE_FARFIELD_TERRAIN=0

# 雾：两个参数必须一起给才有效（公式见 src/cesium/createViewer.js 顶部）
# 把 3 km 之外压成一层雾，接缝与低清底图都退到背景里，近处（1 km 内）几乎不受影响。
VITE_FOG_DENSITY=0.0003
VITE_FOG_VISUAL_SCALAR=0.2

# 相机与画布
VITE_CAMERA_PITCH=-26
VITE_CAMERA_FIT_MAX_RANGE=2800
VITE_CAMERA_FIT_RADIUS_FACTOR=0.42
VITE_CAMERA_FIT_MARGIN=0.98
VITE_CAMERA_MIN_PITCH=-85
VITE_CAMERA_MAX_PITCH=14
VITE_MAX_ZOOM_FACTOR=2.5
VITE_MIN_ZOOM_FACTOR=0.05
VITE_PIN_HEIGHT_M=60
VITE_RESOLUTION_SCALE=2
VITE_RENDER_MODE=flat
